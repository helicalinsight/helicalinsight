{
  "dims_min": 2,
  "dims_max": null,
  "measures_min": 1,
  "measures_max": null,
  "instruction": "Cross-tab summary across row and column dimensions.",
  "aliases": [
    "pivot",
    "pivot table",
    "crosstab table",
    "PivotView"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "table",
    "component": "GridTable",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0,
        "optional": true
      },
      "measure_column": {
        "role": "measure",
        "index": 0,
        "optional": true
      }
    },
    "omit_when_missing": []
  },
  "instructions": [
    "GridTable = AntV S2 wrapper (NOT Ant Design Table). Keep the VF SHORT — use helperFunctions.buildGridTableReport.",
    "Requires ≥2 dimensions: first dim row, remaining dims column (needed for column headers + grand/sub totals).",
    "1) Replace dimensions/measures with real result-column keys from data/SQL.",
    "2) Pass formatStrings when Excel formats are provided. showTotals: true unless user disables.",
    "3) Do not inline a full report/properties blob (it truncates under max_tokens). Never use <Table />."
  ],
  "code": [
    "function DrawGridTable() {",
    "  const { GridTable } = components;",
    "  const { buildGridTableReport } = helperFunctions;",
    "  const minReport = buildGridTableReport({",
    "    dimensions: ['dimension_column', 'dimension_column_2'],",
    "    measures: ['measure_column'],",
    "    formatStrings: { measure_column: '0.00' },",
    "    showTotals: true",
    "  });",
    "  return (",
    "    <div>",
    "      <GridTable",
    "        {...report}",
    "        data={data}",
    "        fields={minReport.fields}",
    "        metadata={minReport.metadata}",
    "        marksList={minReport.marksList}",
    "        report={minReport}",
    "      />",
    "    </div>",
    "  );",
    "}"
  ]
}
