{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 2,
  "measures_max": null,
  "instruction": "Compare several metrics for one/few entities radially.",
  "aliases": [
    "radar chart",
    "spider chart",
    "web chart",
    "radar plot"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Radar",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 2 max any"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Radar. Config: xField=metric/category, yField=measure; seriesField if multi entities; area fillOpacity~0.2-0.5.",
    "Polish: autoFit; shared scale; legend top; thin line; avoid >8 axes; element-active."
  ],
  "code": [
    "function DrawRadar() {",
    "  const { Radar } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Radar {...config} /></div>;",
    "}"
  ]
}
