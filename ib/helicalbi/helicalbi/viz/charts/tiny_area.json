{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Compact trend emphasizing magnitude without full axes.",
  "aliases": [
    "sparkline area",
    "mini area",
    "tiny area chart"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "tiny",
    "component": "TinyArea",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "title": "Chart title"
  },
  "instructions": [
    "TinyArea sparkline. Config: xField, yField; smooth; autoFit.",
    "Polish: soft fill; no axes/legend; compact; trend emphasis."
  ],
  "code": [
    "function DrawTinyArea() {",
    "  const { TinyArea } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    meta: {",
    "      [measureField]: { alias: setting.title || measureField }",
    "    }",
    "  };",
    "  return <div><TinyArea {...config} /></div>;",
    "}"
  ]
}
