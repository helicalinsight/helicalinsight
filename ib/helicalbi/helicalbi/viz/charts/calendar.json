{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 0,
  "measures_max": 1,
  "instruction": "Values/events must be arranged by calendar date.",
  "aliases": [
    "calendar heatmap",
    "calendar chart",
    "date heatmap"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "heatmap",
    "component": "Heatmap",
    "fields": {},
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names separated by comma, min 2 max 2"
    },
    "measures": [
      "provide measure names separated by comma, min 0 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "palette",
      "optional": false,
      "description": "Sequential hex palette for the heat scale"
    }
  },
  "instructions": [
    "Calendar heatmap. Config: Heatmap; meta week_day/month cats; color sequential blues.",
    "Polish: xField/yField from date parts in data; legend continuous bottom; element-active; consistent month/weekday order."
  ],
  "code": [
    "function DrawCalendar() {",
    "  const { Heatmap } = components;",
    "  const setting = ${setting};",
    "  const measureFormats = setting.measure_formats || {};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const formatMeasure = (v, field = measureField) => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',') || fmt.includes('$')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      let out = num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "      if (fmt.trim().startsWith('$')) out = '$' + out;",
    "      return out;",
    "    }",
    "    return raw;",
    "  };",
    "  const xDim = (setting.dimensions.names && setting.dimensions.names[0]) || setting.dimensions.name;",
    "  const yDim = (setting.dimensions.names && setting.dimensions.names[1]) || setting.dimensions.name;",
    "  const config = {",
    "    data,",
    "    xField: xDim,",
    "    yField: yDim,",
    "    colorField: setting.measures[0],",
    "    color: setting.color || ['#BAE7FF', '#1890FF', '#0050B3'],",
    "    meta: {",
    "      [xDim]: { type: 'cat' },",
    "      [yDim]: { type: 'cat' }",
    "    },",
    "    legend: { position: 'bottom' }",
    "  };",
    "  return <div><Heatmap {...config} /></div>;",
    "}"
  ]
}
