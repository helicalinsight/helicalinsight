{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 0,
  "measures_max": 1,
  "instruction": "Values/events must be arranged by calendar date.",
  "aliases": [
    "calendar heatmap",
    "calendar chart",
    "date heatmap"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "heatmap",
    "component": "Heatmap",
    "fields": {},
    "omit_when_missing": []
  },
  "instructions": [
    "Calendar heatmap. Config: Heatmap; meta week_day/month cats; color sequential blues.",
    "Polish: xField/yField from date parts in data; legend continuous bottom; element-active; consistent month/weekday order."
  ],
  "code": [
    "function DrawCalendar() {",
    "  const { Heatmap } = components;",
    "  const config = {",
    "    data,",
    "    xField: '',",
    "    yField: 'month',",
    "    color: ['#B8E1FF', '#9AC5FF', '#7DAAFF', '#5B8FF9', '#3D76DD', '#085EC0', '#0047A5', '#00318A', '#001D70'],",
    "    meta: {",
    "      week_day: {",
    "        type: 'cat',",
    "        values: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']",
    "      },",
    "      month: {",
    "        type: 'cat',",
    "        values: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']",
    "      }",
    "    },",
    "    interactions: [{ type: 'element-active' }]",
    "  };",
    "  return <div><Heatmap {...config} /></div>;",
    "}"
  ]
}
