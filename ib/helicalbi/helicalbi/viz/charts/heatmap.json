{
  "dims_min": 2,
  "dims_max": 2,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "A two-dimensional matrix should encode value by color.",
  "aliases": [
    "heat map",
    "heat-map",
    "matrix heatmap"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "heatmap",
    "component": "Heatmap",
    "fields": {
      "x_field": {
        "role": "dimension",
        "index": 0
      },
      "y_field": {
        "role": "dimension",
        "index": 1
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names separated by comma, min 2 max 2"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "palette",
      "optional": false,
      "description": "Sequential hex palette for the heat scale"
    }
  },
  "instructions": [
    "Heatmap matrix. Config: xField, yField cats; colorField=measure; meta type cat.",
    "Polish: color MUST be a hex array (e.g. [\"#B8E1FF\", \"#5B8FF9\", \"#00318A\"]); never color: { type: \"sequential\" }. Legend bottom; element-active; readable axis ticks; tooltip with value. Apply Excel format strings to measure tooltip/legend when provided."
  ],
  "code": [
    "function DrawHeatmap() {",
    "  const { Heatmap } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const xDim = (setting.dimensions.names && setting.dimensions.names[0]) || setting.dimensions.name;",
    "  const yDim = (setting.dimensions.names && setting.dimensions.names[1]) || setting.dimensions.name;",
    "  const config = {",
    "    data,",
    "    xField: xDim,",
    "    yField: yDim,",
    "    colorField: setting.measures[0],",
    "    color: setting.color || ['#B8E1FF', '#9AC5FF', '#7DAAFF', '#5B8FF9', '#3D76DD', '#085EC0', '#0047A5', '#00318A', '#001D70'],",
    "    meta: {",
    "      [xDim]: { type: 'cat' },",
    "      [yDim]: { type: 'cat' },",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    },",
    "    legend: { position: 'bottom' },",
    "    interactions: [{ type: 'element-active' }]",
    "  };",
    "  return <div><Heatmap {...config} /></div>;",
    "}"
  ]
}
