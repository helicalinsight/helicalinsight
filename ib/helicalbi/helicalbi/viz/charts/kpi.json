{
  "dims_min": 0,
  "dims_max": 0,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "User explicitly asks for a KPI or compact statistic.",
  "aliases": [
    "KPI",
    "statistic",
    "big number",
    "metric card",
    "single value"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "kpi",
    "component": "Statistic",
    "fields": {
      "value_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "optional dimension name (usually unused for KPI)"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "title": "KPI title"
  },
  "instructions": [
    "KPI Statistic in Card. Config: title; value=data[0][measure]; valueStyle; Card border 0.",
    "Polish: one primary number; short title; strong color (#262626 or brand); width flexible; no chart chrome."
  ],
  "code": [
    "function DrawKPI() {",
    "  const { Card, Statistic } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  return (",
    "    <Card loading={false} style={{ width: 200, border: 0 }}>",
    "      <Statistic",
    "        title={setting.title || measureField}",
    "        value={data[0]?.[measureField]}",
    "        valueStyle={{ color: setting.color || '#999' }}",
    "      />",
    "    </Card>",
    "  );",
    "}"
  ]
}
