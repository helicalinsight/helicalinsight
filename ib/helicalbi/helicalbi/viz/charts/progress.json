{
  "dims_min": 0,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 2,
  "instruction": "Completion/attainment with an actual and optional target.",
  "aliases": [
    "progress ring",
    "ring progress",
    "completion",
    "progress chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "percent",
    "component": "RingProgress",
    "fields": {
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "target_column": {
        "role": "measure",
        "index": 1,
        "optional": true
      }
    },
    "omit_when_missing": []
  },
  "instructions": [
    "RingProgress. Config: percent in [0,1] from actual/target; color [progress, track]; statistic content as %.",
    "Polish: clamp percent; 2-color palette; fontSize~14; no fake axes; title via statistic if needed."
  ],
  "code": [
    "function DrawProgress() {",
    "  const { RingProgress } = components;",
    "  const measureField = 'measure_column';",
    "  const targetField = 'target_column';",
    "  const total = data.reduce((sum, row) => sum + (row[measureField] || 0), 0);",
    "  const target = data[0]?.[targetField] ?? total;",
    "  const percent = target > 0 ? total / target : 0;",
    "  const config = {",
    "    percent,",
    "    color: ['#5B8FF9', '#E8EDF3'],",
    "    statistic: {",
    "      content: {",
    "        style: { fontSize: 14 },",
    "        content: `${((typeof percent === 'number' && Number.isFinite(percent) ? percent : Number(percent)) * 100).toFixed(2)}%`",
    "      }",
    "    }",
    "  };",
    "  return <div><RingProgress {...config} /></div>;",
    "}"
  ]
}
