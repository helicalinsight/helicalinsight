{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Default categorical comparison with short labels.",
  "aliases": [
    "column chart",
    "vertical bar",
    "vertical bar chart",
    "bar column"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Column",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Column (vertical). Config: xField=category, yField=measure; seriesField + isGroup|isStack if needed; meta aliases optional.",
    "Polish: autoFit; label middle/white when few cats; axis titles; legend only if series; columnWidthRatio 0.6; interactions element-active; clean tick labels (rotate if long)."
  ],
  "code": [
    "function DrawColumn() {",
    "  const { Column } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    xAxis: {",
    "      title: {",
    "        text: setting.labelsX",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: setting.labelsY",
    "      },",
    "      label: {",
    "",
    "      }",
    "    },",
    "    label: {",
    "      position: 'middle',",
    "      style: { fill: '#FFFFFF', opacity: 0.6 },",
    "",
    "    },",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Column {...config} /></div>;",
    "}"
  ]
}
