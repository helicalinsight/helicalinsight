{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Default categorical comparison with short labels.",
  "aliases": [
    "column chart",
    "vertical bar",
    "vertical bar chart",
    "bar column"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Column",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "instructions": [
    "Column (vertical). Config: xField=category, yField=measure; seriesField + isGroup|isStack if needed; meta aliases optional.",
    "Polish: autoFit; label middle/white when few cats; axis titles; legend only if series; columnWidthRatio 0.6; interactions element-active; clean tick labels (rotate if long)."
  ],
  "code": [
    "function DrawColumn() {",
    "  const { Column } = components;",
    "  // Fill from Excel format strings for matching measure names only; omit unused keys.",
    "  const measureFormats = {",
    "    measure_column: '0.00'",
    "  };",
    "  const formatMeasure = (v, field = 'measure_column') => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      return num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    data,",
    "    xField: 'dimension_column',",
    "    yField: 'measure_column',",
    "    label: {",
    "      position: 'middle',",
    "      style: {",
    "        fill: '#FFFFFF',",
    "        opacity: 0.6",
    "      },",
    "      formatter: (v) => formatMeasure(v, 'measure_column')",
    "    },",
    "    xAxis: {",
    "      title: {",
    "        text: 'Label for dimension axis'",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: 'Label for measure axis'",
    "      },",
    "      label: {",
    "        formatter: (v) => formatMeasure(v, 'measure_column')",
    "      }",
    "    },",
    "    meta: {",
    "      dimension_column: { alias: 'dimension_column' },",
    "      measure_column: { alias: 'measure_column', formatter: (v) => formatMeasure(v, 'measure_column') }",
    "    }",
    "  };",
    "  return <div><Column {...config} /></div>;",
    "}"
  ]
}
