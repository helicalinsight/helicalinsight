{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Default categorical comparison with short labels.",
  "aliases": [
    "column chart",
    "vertical bar",
    "vertical bar chart",
    "bar column"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Column",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names as JSON array, min 1 max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Fill ChartSettings only (JSON). Do NOT invent JS/JSX or component props.",
    "dimensions.names and measures must be real result-column names from data_types / sample_row (JSON arrays).",
    "dimensions.names[0] = category (x-axis); measures[0] = value (y-axis).",
    "Use series when columns should be grouped/stacked.",
    "Set labelsX, labelsY to user-friendly axis titles (aliases OK; need not equal column names).",
    "color: solid hex string or palette array when the template asks; omit if unused.",
    "Do NOT return measure_formats here \u2014 formats are a separate step."
  ],
  "code": [
    "function DrawColumn() {",
    "  const { Column } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const formatMeasure = (v, field = measureField) => {",
    "    const fmt = (measure_formats || setting.measure_formats || {})[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',') || fmt.includes('$')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      let out = num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "      if (fmt.trim().startsWith('$')) out = '$' + out;",
    "      return out;",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.names[0],",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    xAxis: {",
    "      title: {",
    "        text: setting.labelsX",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: setting.labelsY",
    "      },",
    "      label: {",
    "        formatter: (v) => formatMeasure(v, measureField)",
    "      }",
    "    },",
    "    label: {",
    "      position: 'middle',",
    "      style: { fill: '#FFFFFF', opacity: 0.6 },",
    "",
    "    },",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField, formatter: (v) => formatMeasure(v, measureField) }",
    "    }",
    "  };",
    "  return <div><Column {...config} /></div>;",
    "}"
  ]
}
