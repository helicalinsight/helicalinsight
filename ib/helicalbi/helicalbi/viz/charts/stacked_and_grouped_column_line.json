{
  "dims_min": 3,
  "dims_max": 3,
  "measures_min": 2,
  "measures_max": null,
  "instruction": "Both grouping and stacking plus a separate line measure.",
  "aliases": [
    "stacked grouped column line",
    "stack group combo"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "dual_axes",
    "component": "DualAxes",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "secondary_measure_column": {
        "role": "measure",
        "index": 1
      },
      "stack_column": {
        "role": "series",
        "optional": true
      },
      "group_column": {
        "role": "dimension",
        "index": 1,
        "optional": true
      },
      "line_series_column": {
        "role": "series",
        "optional": true
      }
    },
    "omit_when_missing": [
      "stack_column",
      "group_column",
      "line_series_column"
    ]
  },
  "instructions": [
    "DualAxes stack+group column + line. Config: column isStack+isGroup+seriesField+groupField; line seriesField.",
    "Polish: only when 3 dims needed; legend compact; autoFit; keep line visually distinct."
  ],
  "code": [
    "function DrawStackedGroupedColumnLine() {",
    "  const { DualAxes } = components;",
    "  // Fill from Excel format strings for matching measure names only; omit unused keys.",
    "  const measureFormats = {",
    "    measure_column: '0.00'",
    "  };",
    "  const formatMeasure = (v, field = 'measure_column') => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      return num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    data: [data, data],",
    "    xField: 'dimension_column',",
    "    yField: ['measure_column', 'secondary_measure_column'],",
    "    geometryOptions: [",
    "      {",
    "        geometry: 'column',",
    "        isStack: true,",
    "        isGroup: true,",
    "        seriesField: 'stack_column',",
    "        groupField: 'group_column'",
    "      },",
    "      { geometry: 'line', seriesField: 'line_series_column' }",
    "    ],",
    "    meta: {",
    "      measure_column: { alias: 'measure_column', formatter: (v) => formatMeasure(v, 'measure_column') }",
    "    }",
    "  };",
    "  return <div><DualAxes {...config} /></div>;",
    "}"
  ]
}
