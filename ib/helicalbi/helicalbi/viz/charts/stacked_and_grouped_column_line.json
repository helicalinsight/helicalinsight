{
  "dims_min": 3,
  "dims_max": 3,
  "measures_min": 2,
  "measures_max": null,
  "instruction": "Both grouping and stacking plus a separate line measure.",
  "aliases": [
    "stacked grouped column line",
    "stack group combo"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "dual_axes",
    "component": "DualAxes",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "secondary_measure_column": {
        "role": "measure",
        "index": 1
      },
      "stack_column": {
        "role": "series",
        "optional": true
      },
      "group_column": {
        "role": "dimension",
        "index": 1,
        "optional": true
      },
      "line_series_column": {
        "role": "series",
        "optional": true
      }
    },
    "omit_when_missing": [
      "stack_column",
      "group_column",
      "line_series_column"
    ]
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names separated by comma, min 3 max 3"
    },
    "measures": [
      "provide measure names separated by comma, min 2 max any"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "labelsZ": "Label for secondary measure",
    "series": "optional series / group / stack field name"
  },
  "instructions": [
    "DualAxes stack+group column + line. Config: column isStack+isGroup+seriesField+groupField; line seriesField.",
    "Polish: only when 3 dims needed; legend compact; autoFit; keep line visually distinct."
  ],
  "code": [
    "function DrawStackedAndGroupedColumnLine() {",
    "  const { DualAxes } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const config = {",
    "    data: [data, data],",
    "    xField: setting.dimensions.name,",
    "    yField: [setting.measures[0], setting.measures[1]],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    geometryOptions: [",
    "      { geometry: 'column', ...(setting.series ? { seriesField: setting.series } : {}), isStack: true, isGroup: true },",
    "      { geometry: 'line', ...(setting.series ? { seriesField: setting.series } : {}) },",
    "    ],",
    "    meta: {",
    "      [setting.measures[0]]: { alias: setting.labelsY || setting.measures[0] },",
    "      [setting.measures[1]]: { alias: setting.labelsZ || setting.measures[1] }",
    "    }",
    "  };",
    "  return <div><DualAxes {...config} /></div>;",
    "}"
  ]
}
