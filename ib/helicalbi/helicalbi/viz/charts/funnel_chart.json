{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Ordered stages and conversion/drop-off are being shown.",
  "aliases": [
    "funnel",
    "funnel chart",
    "conversion funnel"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Funnel",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Funnel. Config: xField=stage, yField=measure; dynamicHeight; conversionTag; label middle.",
    "Polish: ordered stages descending; element-active; clear stage names; autoFit."
  ],
  "code": [
    "function DrawFunnelChart() {",
    "  const { Funnel } = components;",
    "  const setting = ${setting};",
    "  const measureFormats = setting.measure_formats || {};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const formatMeasure = (v, field = measureField) => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',') || fmt.includes('$')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      let out = num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "      if (fmt.trim().startsWith('$')) out = '$' + out;",
    "      return out;",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField, formatter: (v) => formatMeasure(v, measureField) }",
    "    }",
    "  };",
    "  return <div><Funnel {...config} /></div>;",
    "}"
  ]
}
