{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 2,
  "measures_max": 2,
  "instruction": "One measure is bars and another is a trend line.",
  "aliases": [
    "column line",
    "combo chart",
    "bar line",
    "column + line"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "dual_axes",
    "component": "DualAxes",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "secondary_measure_column": {
        "role": "measure",
        "index": 1
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 2 max 2"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "labelsZ": "Label for secondary measure"
  },
  "instructions": [
    "DualAxes column+line. Config: data:[data,data]; xField; yField:[m1,m2]; geometryOptions [{geometry:'column'},{geometry:'line', lineStyle:{lineWidth:2}}].",
    "Polish: bars for volume, line for trend; dual y titles; legend; autoFit."
  ],
  "code": [
    "function DrawColumnLine() {",
    "  const { DualAxes } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const config = {",
    "    data: [data, data],",
    "    xField: setting.dimensions.name,",
    "    yField: [setting.measures[0], setting.measures[1]],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    geometryOptions: [",
    "      { geometry: 'column' },",
    "      { geometry: 'line', ...(setting.series ? { seriesField: setting.series } : {}) },",
    "    ],",
    "    meta: {",
    "      [setting.measures[0]]: { alias: setting.labelsY || setting.measures[0] },",
    "      [setting.measures[1]]: { alias: setting.labelsZ || setting.measures[1] }",
    "    }",
    "  };",
    "  return <div><DualAxes {...config} /></div>;",
    "}"
  ]
}
