{
  "dims_min": 1,
  "dims_max": 2,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Hierarchical part-to-whole using nested rectangles.",
  "aliases": [
    "tree map",
    "tree-map",
    "treemap chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "hierarchy",
    "component": "Treemap",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names separated by comma, min 1 max 2"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "title": "Chart title"
  },
  "instructions": [
    "Treemap. Config: hierarchical data root+children; colorField; label fields=[dim].",
    "Polish: value=measure; clear parent/child names; element-active; limited colors; skip tiny-label clutter."
  ],
  "code": [
    "function DrawTreemap() {",
    "  const { Treemap } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const dimensionField = setting.dimensions.name || (setting.dimensions.names && setting.dimensions.names[0]);",
    "  const chartData = {",
    "    name: 'root',",
    "    children: data.map((item) => ({",
    "      name: item[dimensionField],",
    "      value: item[measureField],",
    "      ...item",
    "    }))",
    "  };",
    "  const config = {",
    "    data: chartData,",
    "    colorField: 'name',",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    label: {",
    "      fields: [dimensionField]",
    "    },",
    "    meta: {",
    "      [measureField]: { alias: setting.title || measureField }",
    "    }",
    "  };",
    "  return <div><Treemap {...config} /></div>;",
    "}"
  ]
}
