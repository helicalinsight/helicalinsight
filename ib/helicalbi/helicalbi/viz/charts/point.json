{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "User explicitly asks for individual point marks.",
  "aliases": [
    "point chart",
    "points",
    "point plot"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Scatter",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Point/Scatter marks. Config: Scatter; xField, yField; shape circle|diamond; size optional.",
    "Polish: autoFit; low opacity if dense; interactions element-active; axis titles; no fake series colors unless colorField present."
  ],
  "code": [
    "function DrawPoint() {",
    "  const { Scatter } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    xAxis: {",
    "      title: {",
    "        text: setting.labelsX",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: setting.labelsY",
    "      },",
    "      label: {",
    "",
    "      }",
    "    },",
    "    shape: 'circle',",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Scatter {...config} /></div>;",
    "}"
  ]
}
