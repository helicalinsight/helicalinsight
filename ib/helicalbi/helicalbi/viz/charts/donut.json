{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "User explicitly uses the 'donut' spelling.",
  "aliases": [
    "donut chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "pie",
    "component": "Pie",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "title_text": {
        "role": "title",
        "optional": true
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "title": "Chart title"
  },
  "instructions": [
    "Donut (alias). Config: Pie + innerRadius~0.6; angleField, colorField; statistic center total.",
    "Polish: same as doughnut-clean center, sparse labels, legend if many slices, element-active."
  ],
  "code": [
    "function DrawDonut() {",
    "  const { Pie } = components;",
    "  const setting = ${setting};",
    "  const measureFormats = setting.measure_formats || {};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const formatMeasure = (v, field = measureField) => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',') || fmt.includes('$')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      let out = num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "      if (fmt.trim().startsWith('$')) out = '$' + out;",
    "      return out;",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    appendPadding: 10,",
    "    data,",
    "    angleField: setting.measures[0],",
    "    colorField: setting.dimensions.name,",
    "    radius: 0.8,",
    "    innerRadius: 0.6,",
    "    statistic: {",
    "      title: {",
    "        style: { color: '#000', fontSize: 14 },",
    "        formatter: () => setting.title || ''",
    "      },",
    "      content: {",
    "        style: { fontSize: 14 },",
    "        content: String(",
    "          data.reduce((sum, row) => sum + (row[measureField] || 0), 0)",
    "        )",
    "      }",
    "    },",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    label: {",
    "      type: 'outer',",
    "      content: '{name}: {percentage}'",
    "    },",
    "    interactions: [{ type: 'element-active' }],",
    "    meta: {",
    "      [measureField]: { alias: setting.title || measureField, formatter: (v) => formatMeasure(v, measureField) }",
    "    }",
    "  };",
    "  return <div><Pie {...config} /></div>;",
    "}"
  ]
}
