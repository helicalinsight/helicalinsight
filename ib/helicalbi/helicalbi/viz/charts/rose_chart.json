{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Cyclical/radial category comparison is meaningful.",
  "aliases": [
    "rose",
    "rose chart",
    "polar bar",
    "coxcomb"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Rose",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "series_column": {
        "role": "series",
        "optional": true
      }
    },
    "omit_when_missing": [
      "series_column"
    ]
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "series": "optional series / group / stack field name"
  },
  "instructions": [
    "Rose. Config: xField=category, yField=measure; seriesField optional; radius~0.9; label offset -15.",
    "Polish: element-active; legend if series; limit categories; soft palette; autoFit."
  ],
  "code": [
    "function DrawRoseChart() {",
    "  const { Rose } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    seriesField: setting.dimensions.name,",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Rose {...config} /></div>;",
    "}"
  ]
}
