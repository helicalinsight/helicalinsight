{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 0,
  "measures_max": 1,
  "instruction": "Word frequency/prominence is the requested insight.",
  "aliases": [
    "word cloud",
    "tag cloud",
    "wordcloud chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "other",
    "component": "WordCloud",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "instructions": [
    "WordCloud. Config: map dim->name, weight=value|count; wordField name; weightField value.",
    "Polish: single color or soft palette; interactions element-active; avoid tiny unreadable words; no extra axes."
  ],
  "code": [
    "function DrawWordCloud() {",
    "  const { WordCloud } = components;",
    "  const dimensionField = 'dimension_column';",
    "  const cloudData = data.map((item) => ({",
    "    ...item,",
    "    name: item[dimensionField],",
    "    value: 1",
    "  }));",
    "  const config = {",
    "    data: cloudData,",
    "    wordField: 'name',",
    "    weightField: 'value',",
    "    color: 'rgba(76, 132, 238, 1)',",
    "    interactions: [{ type: 'element-active' }]",
    "  };",
    "  return <div><WordCloud {...config} /></div>;",
    "}"
  ]
}
