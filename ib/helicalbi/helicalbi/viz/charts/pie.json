{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "User explicitly requests a pie chart.",
  "aliases": [
    "pie chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "pie",
    "component": "Pie",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "title": "Chart title",
    "color": {
      "mode": "palette",
      "optional": true,
      "description": "Optional slice color palette of hex colors"
    }
  },
  "instructions": [
    "Pie (explicit). Config: angleField, colorField; radius~0.8.",
    "Polish: outer labels + %; legend right if crowded; appendPadding; element-active; avoid 3D/explode; <=8 categories."
  ],
  "code": [
    "function DrawPie() {",
    "  const { Pie } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    appendPadding: 10,",
    "    data,",
    "    angleField: setting.measures[0],",
    "    colorField: setting.dimensions.name,",
    "    radius: 0.8,",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    label: {",
    "      type: 'outer',",
    "      content: '{name}: {percentage}'",
    "    },",
    "    interactions: [{ type: 'element-active' }],",
    "    meta: {",
    "      [measureField]: { alias: setting.title || measureField }",
    "    }",
    "  };",
    "  return <div><Pie {...config} /></div>;",
    "}"
  ]
}
