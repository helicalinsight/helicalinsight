{
  "dims_min": 0,
  "dims_max": 1,
  "measures_min": 2,
  "measures_max": null,
  "instruction": "Correlation also needs size and optional category color.",
  "aliases": [
    "bubble",
    "bubble chart",
    "bubble plot"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "bubble",
    "component": "Scatter",
    "fields": {
      "x_measure_column": {
        "role": "measure",
        "index": 0
      },
      "y_measure_column": {
        "role": "measure",
        "index": 1
      },
      "size_measure_column": {
        "role": "measure",
        "index": 2,
        "optional": true
      },
      "dimension_column": {
        "role": "dimension",
        "index": 0,
        "optional": true
      }
    },
    "omit_when_missing": [
      "dimension_column"
    ]
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names as JSON array, min 0 max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 2 max any"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "labelsZ": "Label for size / z field"
  },
  "instructions": [
    "Fill ChartSettings only (JSON). Do NOT invent JS/JSX or component props.",
    "dimensions.names and measures must be real result-column names from data_types / sample_row (JSON arrays).",
    "measures[0]=x, measures[1]=y, measures[2]=size when available.",
    "Optional dimensions.names[0] for color; set labelsX / labelsY / labelsZ.",
    "Set labelsX, labelsY, labelsZ to user-friendly axis titles (aliases OK; need not equal column names).",
    "color: solid hex string or palette array when the template asks; omit if unused.",
    "Do NOT return measure_formats here — formats are a separate step."
  ],
  "code": [
    "function DrawBubbleChart() {",
    "  const { Scatter } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const config = {",
    "    data,",
    "    xField: setting.measures[0],",
    "    yField: setting.measures[1],",
    "    sizeField: setting.measures[2] || setting.measures[1],",
    "    size: [4, 30],",
    "    shape: 'circle',",
    "    ...(setting.dimensions.names[0] ? { colorField: setting.dimensions.names[0] } : {}),",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    xAxis: { title: { text: setting.labelsX } },",
    "    yAxis: { title: { text: setting.labelsY } },",
    "    interactions: [{ type: 'element-active' }],",
    "    meta: {",
    "      [setting.measures[0]]: { alias: setting.labelsX || setting.measures[0] },",
    "      [setting.measures[1]]: { alias: setting.labelsY || setting.measures[1] }",
    "    }",
    "  };",
    "  return <div><Scatter {...config} /></div>;",
    "}"
  ]
}
