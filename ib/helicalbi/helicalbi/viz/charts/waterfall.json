{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Sequential positive/negative contributions to a total.",
  "aliases": [
    "waterfall chart",
    "bridge chart",
    "waterfall plot"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Waterfall",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Waterfall. Config: xField=ordered stages, yField=delta; total.label; linkStyle dashed.",
    "Polish: autoFit; rising/falling colors if available; axis titles; label middle for values; clear Total; element-active."
  ],
  "code": [
    "function DrawWaterfall() {",
    "  const { Waterfall } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    xAxis: {",
    "      title: {",
    "        text: setting.labelsX",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: setting.labelsY",
    "      },",
    "      label: {",
    "",
    "      }",
    "    },",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Waterfall {...config} /></div>;",
    "}"
  ]
}
