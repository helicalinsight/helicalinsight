{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Ranked comparison or long category labels need space.",
  "aliases": [
    "bar chart",
    "horizontal bar",
    "horizontal bar chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "bar",
    "component": "Bar",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "series_field": {
        "role": "series",
        "optional": true
      },
      "title_text": {
        "role": "title",
        "optional": true
      }
    },
    "omit_when_missing": [
      "series_field",
      "legend"
    ]
  },
  "instructions": [
    "Bar (horizontal). Config: xField=measure, yField=category; seriesField + isGroup|isStack if multi-series.",
    "Polish: autoFit; axis titles from fields; legend top-left only if series; label left when <=12 cats else omit; maxBarWidth~40; interactions element-active; muted grid; no decorative junk."
  ],
  "code": [
    "function DrawBar() {",
    "  const { Bar } = components;",
    "  // Fill from Excel format strings for matching measure names only; omit unused keys.",
    "  const measureFormats = {",
    "    measure_column: '0.00'",
    "  };",
    "  const formatMeasure = (v, field = 'measure_column') => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      return num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    data,",
    "    xField: 'measure_column',",
    "    yField: 'dimension_column',",
    "    title: {",
    "      visible: true,",
    "      text: 'title_text',",
    "      align: 'center'",
    "    },",
    "    xAxis: {",
    "      title: {",
    "        text: 'Label for measure axis'",
    "      },",
    "      label: {",
    "        formatter: (v) => formatMeasure(v, 'measure_column')",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: 'Label for dimension axis'",
    "      }",
    "    },",
    "    seriesField: 'series_field',",
    "    legend: {",
    "      position: 'top-left'",
    "    },",
    "    meta: {",
    "      measure_column: { alias: 'measure_column', formatter: (v) => formatMeasure(v, 'measure_column') }",
    "    }",
    "  };",
    "  return <div><Bar {...config} /></div>;",
    "}"
  ]
}
