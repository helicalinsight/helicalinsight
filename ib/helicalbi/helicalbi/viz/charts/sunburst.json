{
  "dims_min": 2,
  "dims_max": null,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Multi-level hierarchy using concentric rings.",
  "aliases": [
    "sunburst chart",
    "radial hierarchy",
    "sun burst"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "hierarchy",
    "component": "Sunburst",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "secondary_dimension_column": {
        "role": "dimension",
        "index": 1
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names as JSON array, min 2 max any"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "title": "Chart title"
  },
  "instructions": [
    "Fill ChartSettings only (JSON). Do NOT invent JS/JSX or component props.",
    "dimensions.names and measures must be real result-column names from data_types / sample_row (JSON arrays).",
    "dimensions.names = hierarchy levels (2+); measures[0] = segment value.",
    "Set title to a short chart heading.",
    "color: solid hex string or palette array when the template asks; omit if unused.",
    "Do NOT return measure_formats here — formats are a separate step."
  ],
  "code": [
    "function DrawSunburst() {",
    "  const { Sunburst } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const dimensionField = setting.dimensions.names[0];",
    "  const chartData = {",
    "    name: 'root',",
    "    children: data.map((item) => ({",
    "      name: item[dimensionField],",
    "      value: item[measureField],",
    "      ...item",
    "    }))",
    "  };",
    "  const config = {",
    "    data: chartData,",
    "    colorField: 'name',",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    label: {",
    "      fields: [dimensionField]",
    "    },",
    "    meta: {",
    "      [measureField]: { alias: setting.title || measureField }",
    "    }",
    "  };",
    "  return <div><Sunburst {...config} /></div>;",
    "}"
  ]
}
