{
  "dims_min": 2,
  "dims_max": null,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Multi-level hierarchy using concentric rings.",
  "aliases": [
    "sunburst chart",
    "radial hierarchy",
    "sun burst"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "hierarchy",
    "component": "Sunburst",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "secondary_dimension_column": {
        "role": "dimension",
        "index": 1
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "instructions": [
    "Sunburst. Config: nest {name,children}; innerRadius~0.2; build from primary+secondary dim + measure.",
    "Polish: element-active; readable leaf labels; muted root; avoid >3 depth."
  ],
  "code": [
    "function DrawSunburst() {",
    "  const { Sunburst } = components;",
    "  // Fill from Excel format strings for matching measure names only; omit unused keys.",
    "  const measureFormats = {",
    "    measure_column: '0.00'",
    "  };",
    "  const formatMeasure = (v, field = 'measure_column') => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      return num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "    }",
    "    return raw;",
    "  };",
    "  const primaryDimension = 'dimension_column';",
    "  const secondaryDimension = 'secondary_dimension_column';",
    "  const measureField = 'measure_column';",
    "  const grouped = data.reduce((result, item) => {",
    "    const primary = String(item[primaryDimension]);",
    "    let parent = result.find((node) => node.name === primary);",
    "    if (!parent) {",
    "      parent = { name: primary, children: [] };",
    "      result.push(parent);",
    "    }",
    "    parent.children.push({",
    "      name: String(item[secondaryDimension] ?? primary),",
    "      value: Number(item[measureField]) || 0",
    "    });",
    "    return result;",
    "  }, []);",
    "  const config = {",
    "    data: { name: 'root', children: grouped },",
    "    innerRadius: 0.2,",
    "    interactions: [{ type: 'element-active' }],",
    "    meta: {",
    "      measure_column: { alias: 'measure_column', formatter: (v) => formatMeasure(v, 'measure_column') }",
    "    }",
    "  };",
    "  return <div><Sunburst {...config} /></div>;",
    "}"
  ]
}
