{
  "dims_min": 0,
  "dims_max": 1,
  "measures_min": 2,
  "measures_max": null,
  "instruction": "Correlation between two numeric measures.",
  "aliases": [
    "scatter plot",
    "scatter chart",
    "xy plot",
    "scatterplot"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Scatter",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 0 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 2 max any"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Scatter. Config: xField, yField (prefer 2 measures or dim+measure); shape circle; colorField optional.",
    "Polish: autoFit; size 4-6; opacity 0.7 if n>50; interactions element-active; axis titles; legend if colorField; regression only if asked."
  ],
  "code": [
    "function DrawScatter() {",
    "  const { Scatter } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    xAxis: {",
    "      title: {",
    "        text: setting.labelsX",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: setting.labelsY",
    "      },",
    "      label: {",
    "",
    "      }",
    "    },",
    "    shape: 'circle',",
    "    interactions: [{ type: 'element-active' }],",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Scatter {...config} /></div>;",
    "}"
  ]
}
