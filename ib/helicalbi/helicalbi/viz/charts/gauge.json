{
  "dims_min": 0,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 2,
  "instruction": "User explicitly asks for a gauge/dial against a target.",
  "aliases": [
    "gauge chart",
    "dial",
    "speedometer",
    "meter"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "percent",
    "component": "Gauge",
    "fields": {
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "target_column": {
        "role": "measure",
        "index": 1,
        "optional": true
      }
    },
    "omit_when_missing": []
  },
  "instructions": [
    "Gauge. Config: percent [0,1]; range.color; indicator pointer/pin muted.",
    "Polish: actual/target -> percent; soft track color; no noisy ticks; keep label minimal."
  ],
  "code": [
    "function DrawGauge() {",
    "  const { Gauge } = components;",
    "  // Fill from Excel format strings for matching measure names only; omit unused keys.",
    "  const measureFormats = {",
    "    measure_column: '0.00'",
    "  };",
    "  const formatMeasure = (v, field = 'measure_column') => {",
    "    const fmt = measureFormats[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      return num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "    }",
    "    return raw;",
    "  };",
    "  const measureField = 'measure_column';",
    "  const targetField = 'target_column';",
    "  const total = data.reduce((sum, row) => sum + (row[measureField] || 0), 0);",
    "  const target = data[0]?.[targetField] ?? total;",
    "  const percent = target > 0 ? total / target : 0;",
    "  const config = {",
    "    percent,",
    "    range: {",
    "      color: ['#5B8FF9', '#E8EDF3']",
    "    },",
    "    indicator: {",
    "      pointer: { style: { stroke: '#D0D0D0' } },",
    "      pin: { style: { stroke: '#D0D0D0' } }",
    "    },",
    "    meta: {",
    "      measure_column: { alias: 'measure_column', formatter: (v) => formatMeasure(v, 'measure_column') }",
    "    }",
    "  };",
    "  return <div><Gauge {...config} /></div>;",
    "}"
  ]
}
