{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": null,
  "instruction": "Trend where cumulative magnitude/volume must be stressed.",
  "aliases": [
    "area chart",
    "filled area",
    "area plot"
  ],
  "requires_ordered": true,
  "base": "default",
  "conversion": {
    "family": "cartesian",
    "component": "Area",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "name": "provide the dimension name min 1 and max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max can be any"
    ],
    "labelsX": "Label for x field",
    "labelsY": "Label for y field",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Area. Config: xField=ordered dim, yField=measure; seriesField + isStack for stacked area.",
    "Polish: autoFit; soft areaStyle fillOpacity~0.6; line on top; axis titles; legend if series; point false unless sparse; interactions element-active."
  ],
  "code": [
    "function DrawArea() {",
    "  const { Area } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const config = {",
    "    data,",
    "    xField: setting.dimensions.name,",
    "    yField: setting.measures[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    ...(setting.series ? { seriesField: setting.series } : {}),",
    "    xAxis: {",
    "      title: {",
    "        text: setting.labelsX",
    "      }",
    "    },",
    "    yAxis: {",
    "      title: {",
    "        text: setting.labelsY",
    "      },",
    "      label: {",
    "",
    "      }",
    "    },",
    "    areaStyle: {",
    "      fill: 'l(270) 0:#ffffff 0.5:#69b2f8 1:#0050b3'",
    "    },",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsY || measureField }",
    "    }",
    "  };",
    "  return <div><Area {...config} /></div>;",
    "}"
  ]
}
