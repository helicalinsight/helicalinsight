{
  "dims_min": 0,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 2,
  "instruction": "Completion/attainment with an actual and optional target.",
  "aliases": [
    "progress ring",
    "ring progress",
    "completion",
    "progress chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "percent",
    "component": "RingProgress",
    "fields": {
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "target_column": {
        "role": "measure",
        "index": 1,
        "optional": true
      }
    },
    "omit_when_missing": []
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names as JSON array, min 0 max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 2"
    ],
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    },
    "title": "Chart title"
  },
  "instructions": [
    "Fill ChartSettings only (JSON). Do NOT invent JS/JSX or component props.",
    "dimensions.names and measures must be real result-column names from data_types / sample_row (JSON arrays).",
    "measures[0]=progress value (and measures[1]=target when present).",
    "Set title to a short chart heading.",
    "color: solid hex string or palette array when the template asks; omit if unused.",
    "Do NOT return measure_formats here — formats are a separate step."
  ],
  "code": [
    "function DrawProgress() {",
    "  const { RingProgress } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const targetField = setting.measures[1];",
    "  const total = data.reduce((sum, row) => sum + (row[measureField] || 0), 0);",
    "  const target = targetField ? (data[0]?.[targetField] ?? total) : total;",
    "  const percent = target > 0 ? Math.min(total / target, 1) : 0;",
    "  const config = {",
    "    percent,",
    "    color: setting.color || ['#5B8FF9', '#E8EDF3'],",
    "    statistic: {",
    "      content: {",
    "        style: { fontSize: 14 },",
    "        content: `${((typeof percent === 'number' && Number.isFinite(percent) ? percent : Number(percent)) * 100).toFixed(2)}%`",
    "      }",
    "    }",
    "  };",
    "  return <div><RingProgress {...config} /></div>;",
    "}"
  ]
}
