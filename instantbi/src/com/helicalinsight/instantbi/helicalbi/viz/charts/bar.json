{
  "dims_min": 1,
  "dims_max": 1,
  "measures_min": 1,
  "measures_max": 1,
  "instruction": "Ranked comparison or long category labels need space.",
  "aliases": [
    "bar chart",
    "horizontal bar",
    "horizontal bar chart"
  ],
  "requires_ordered": false,
  "base": "default",
  "conversion": {
    "family": "bar",
    "component": "Bar",
    "fields": {
      "dimension_column": {
        "role": "dimension",
        "index": 0
      },
      "measure_column": {
        "role": "measure",
        "index": 0
      },
      "series_field": {
        "role": "series",
        "optional": true
      },
      "title_text": {
        "role": "title",
        "optional": true
      }
    },
    "omit_when_missing": [
      "series_field",
      "legend"
    ]
  },
  "settings": {
    "dimensions": {
      "names": "provide dimension names as JSON array, min 1 max 1"
    },
    "measures": [
      "provide measure names separated by comma, min 1 max 1"
    ],
    "labelsX": "Label for measure axis (x)",
    "labelsY": "Label for dimension axis (y)",
    "title": "Chart title",
    "series": "optional series / group field name",
    "color": {
      "mode": "optional",
      "optional": true,
      "description": "Solid hex string or palette array of hex colors"
    }
  },
  "instructions": [
    "Fill ChartSettings only (JSON). Do NOT invent JS/JSX or component props.",
    "dimensions.names and measures must be real result-column names from data_types / sample_row (JSON arrays).",
    "dimensions.names[0] = category (y-axis); measures[0] = value (x-axis).",
    "Use series when the bar should be grouped/stacked by another category field.",
    "Set labelsX, labelsY to user-friendly axis titles (aliases OK; need not equal column names).",
    "Set title to a short chart heading.",
    "Set series only when a result column should split color/group/stack; else omit/null.",
    "color: solid hex string or palette array when the template asks; omit if unused.",
    "Do NOT return measure_formats here \u2014 formats are a separate step."
  ],
  "code": [
    "function DrawBar() {",
    "  const { Bar } = components;",
    "  const setting = ${setting};",
    "  const measure_formats = ${format};",
    "  const measureField = (setting.measures && setting.measures[0]) || '';",
    "  const formatMeasure = (v, field = measureField) => {",
    "    const fmt = (measure_formats || setting.measure_formats || {})[field];",
    "    const raw = (v != null && typeof v === 'object') ? (v[field] ?? v.value ?? v) : v;",
    "    if (!fmt || raw == null || raw === '') return raw;",
    "    const num = typeof raw === 'number' ? raw : Number(raw);",
    "    if (typeof num !== 'number' || !Number.isFinite(num)) return raw;",
    "    if (fmt === '0.00' || fmt === '0.0#' || /^0\\.0+$/.test(fmt)) {",
    "      return num.toFixed((fmt.split('.')[1] || '').length);",
    "    }",
    "    if (fmt.includes('#') || fmt.includes(',') || fmt.includes('$')) {",
    "      const decimals = (fmt.split('.')[1] || '').replace(/[^0]/g, '').length;",
    "      let out = num.toLocaleString(undefined, {",
    "        minimumFractionDigits: decimals,",
    "        maximumFractionDigits: decimals || 0",
    "      });",
    "      if (fmt.trim().startsWith('$')) out = '$' + out;",
    "      return out;",
    "    }",
    "    return raw;",
    "  };",
    "  const config = {",
    "    data,",
    "    xField: setting.measures[0],",
    "    yField: setting.dimensions.names[0],",
    "    ...(setting.color ? { color: setting.color } : {}),",
    "    title: {",
    "      visible: !!setting.title,",
    "      text: setting.title,",
    "      align: 'center'",
    "    },",
    "    xAxis: {",
    "      title: { text: setting.labelsX },",
    "      label: {}",
    "    },",
    "    yAxis: {",
    "      title: { text: setting.labelsY }",
    "    },",
    "    ...(setting.series ? { seriesField: setting.series, legend: { position: 'top-left' } } : {}),",
    "    meta: {",
    "      [measureField]: { alias: setting.labelsX || measureField, formatter: (v) => formatMeasure(v, measureField) }",
    "    }",
    "  };",
    "  return <div><Bar {...config} /></div>;",
    "}"
  ]
}
