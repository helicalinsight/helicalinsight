{
  "version": 2,
  "default_strategy": "mece_metric_structuring",
  "intents": [
    {
      "id": "alert",
      "keywords": ["running out", "out of stock", "stock", "blocker", "bottleneck", "rejection", "alert", "threshold"]
    },
    {
      "id": "wait",
      "keywords": ["waiting", "wait time", "sla", "queue"]
    },
    {
      "id": "compare",
      "keywords": ["compare", "versus", " vs ", "quarter", "yoy", "year over year"]
    },
    {
      "id": "why",
      "keywords": ["why", "root cause", "attrition", "factor", "driver", "explain"]
    },
    {
      "id": "roi",
      "keywords": ["roi", "budget", "allocation", "spend"]
    },
    {
      "id": "target",
      "keywords": ["target", "goal", "quota", "benchmark"]
    }
  ],
  "strategies": {
    "inverted_pyramid": {
      "id": "inverted_pyramid",
      "title": "Executive KPI",
      "template_id": "executive-kpi-first",
      "layout": "Top: headline KPI. Middle: trend. Bottom: short table.",
      "charts": [
        {"level": "top", "title": "Headline", "viz_hint": "kpi", "purpose": "Headline value.", "context_anchor": "vs target or prior period"},
        {"level": "middle", "title": "Trend", "viz_hint": "line", "purpose": "Trend under the headline."},
        {"level": "bottom", "title": "Focus list", "viz_hint": "table", "purpose": "Where to look next."}
      ]
    },
    "progressive_disclosure": {
      "id": "progressive_disclosure",
      "title": "Drill-down",
      "template_id": "drilldown-hierarchical",
      "layout": "Overview, then one driver breakdown, then a detail table.",
      "charts": [
        {"level": "primary", "title": "Overview", "viz_hint": "bar", "purpose": "High-level breakdown."},
        {"level": "supporting", "title": "Driver", "viz_hint": "bar", "purpose": "One driver slice."},
        {"level": "detail", "title": "Detail", "viz_hint": "table", "purpose": "Detail rows."}
      ]
    },
    "mece_metric_structuring": {
      "id": "mece_metric_structuring",
      "title": "Analytical grid",
      "template_id": "analytical-grid",
      "layout": "Outcome KPI, then one dimension breakdown, then the period trend.",
      "charts": [
        {"level": "top", "title": "Outcome", "viz_hint": "kpi", "purpose": "Outcome metric.", "context_anchor": "vs compared period"},
        {"level": "middle", "title": "Breakdown", "viz_hint": "bar", "purpose": "Breakdown by one semantic dimension."},
        {"level": "bottom", "title": "Period", "viz_hint": "line", "purpose": "Period movement of the same metric."}
      ]
    },
    "semantic_color_coding": {
      "id": "semantic_color_coding",
      "title": "Operational exceptions",
      "template_id": "operational-realtime",
      "layout": "Exception KPI, then the failing breakdown, then a status table.",
      "charts": [
        {"level": "top", "title": "Exceptions", "viz_hint": "kpi", "purpose": "What needs attention now.", "context_anchor": "vs threshold"},
        {"level": "middle", "title": "Breakdown", "viz_hint": "bar", "purpose": "Where the exception is."},
        {"level": "bottom", "title": "Status", "viz_hint": "table", "purpose": "Items to act on."}
      ]
    }
  },
  "rules": [
    {"intent": "alert", "layout": "semantic_color_coding"},
    {"intent": "wait", "layout": "inverted_pyramid"},
    {"intent": "compare", "persona": "executive", "layout": "inverted_pyramid"},
    {"intent": "compare", "persona": "analyst", "layout": "progressive_disclosure"},
    {"intent": "compare", "persona": "tactical_manager", "layout": "progressive_disclosure"},
    {"intent": "compare", "layout": "mece_metric_structuring"},
    {"intent": "why", "persona": "executive", "layout": "inverted_pyramid"},
    {"intent": "why", "persona": "analyst", "layout": "progressive_disclosure"},
    {"intent": "why", "persona": "tactical_manager", "layout": "mece_metric_structuring"},
    {"intent": "why", "layout": "progressive_disclosure"},
    {"intent": "roi", "persona": "executive", "layout": "inverted_pyramid"},
    {"intent": "roi", "layout": "semantic_color_coding"},
    {"persona": "executive", "layout": "inverted_pyramid"},
    {"persona": "operational_manager", "layout": "semantic_color_coding"},
    {"persona": "analyst", "layout": "progressive_disclosure"},
    {"layout": "mece_metric_structuring"}
  ]
}
