# HelicalBI Docker Compose — copy to ".env" and edit (this file is committed).
# PowerShell: Copy-Item .env.example .env
# Bash:       cp .env.example .env

# stub = deterministic LLM tests (no model API). live = real LLMManager (+ OpenAI for GEval when used).
HELICALBI_LLM_MODE=stub

# LLM provider API keys (referenced from helicalbi/config/llm_config.yaml as ${VAR})
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Ollama requires no API key; set the local server URL when using default_provider: ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional Travle_Agent integration overrides (see tests/llm/llm_test_config.yaml)
# HELICALBI_TEST_BASE_URL=
# HELICALBI_TEST_SESSION_COOKIE=
# HELICALBI_TEST_MODEL_DIR=0806
# HELICALBI_TEST_MODEL_FILE=Travle_Agent.model
# HELICALBI_TEST_METADATA_DIR=test
# HELICALBI_TEST_METADATA_FILE=pg_sample_travel_data.metadata


# Service runtime (use HELICALBI_ENV=dev for local debug)
HELICALBI_ENV=production
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=4
FLASK_DEBUG=0
