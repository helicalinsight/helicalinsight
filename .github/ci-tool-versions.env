# CI tooling versions — bump here only (workflow reads this file).
#
# JAVA_VERSIONS / NODE_VERSIONS: space-separated → matrix for tests
# *_RELEASE_VERSION: used for tag packaging (must be listed in the matching VERSIONS list)
# Use JDKs >= server/pom.xml <jdk.version> (currently 25) or Java builds will fail.
JAVA_VERSIONS=25
JAVA_RELEASE_VERSION=25
JAVA_DISTRIBUTION=temurin
NODE_VERSIONS=20
NODE_RELEASE_VERSION=20
