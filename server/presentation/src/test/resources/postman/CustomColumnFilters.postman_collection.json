{
	"info": {
		"_postman_id": "c4f1a8e0-9b2d-4e1a-8c7f-custom-col-filters",
		"name": "Custom column filters (WHERE / HAVING)",
		"description": "Import this collection. Set `baseUrl` (default http://localhost:8085/hi-ee).\n\n1. Run **0. Login** first (hiadmin/hiadmin). Token is saved automatically.\n2. Run **generateQuery** requests to inspect SQL in `response.query`.\n3. Run **fetchData** if `HReportTest/Metadata_HReportTest.metadata` exists on the server.\n\nCustom filter/having shape:\n```\n\"custom\": true,\n\"column\": { \"column\": \"\\\"booking_platform\\\"\", \"alias\": \"bk_pf\" }\n```\nHAVING also sends `\"function\": \"db.generic.aggregate.sum\"`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8085/hi-ee" },
		{ "key": "username", "value": "hiadmin" },
		{ "key": "password", "value": "hiadmin" },
		{ "key": "token", "value": "" },
		{ "key": "location", "value": "HReportTest" },
		{ "key": "metadataFileName", "value": "Metadata_HReportTest.metadata" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
	},
	"item": [
		{
			"name": "0. Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
							"const json = pm.response.json();",
							"const token = json.token || pm.response.headers.get('token');",
							"pm.test('token present', function () { pm.expect(token).to.be.ok; });",
							"if (token) {",
							"  pm.collectionVariables.set('token', String(token).replace(/^Bearer\\s+/i, ''));",
							"}"
						]
					}
				}
			],
			"request": {
				"auth": { "type": "noauth" },
				"method": "POST",
				"header": [ { "key": "Content-Type", "value": "application/json" } ],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": "{{baseUrl}}/rest/authToken",
				"description": "If decrypt fails, log in via the UI and paste the Bearer token into collection variable `token`."
			}
		},
		{
			"name": "generateQuery",
			"item": [
				{
					"name": "1. Combined — custom WHERE + concat + custom HAVING sum",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"pm.test('status 1', function () { pm.expect(json.status).to.eql(1); });",
									"const query = (json.response && json.response.query) || '';",
									"pm.test('query present', function () { pm.expect(query).to.be.a('string').and.not.empty; });",
									"const where = (query.split(/\\bwhere\\b/i)[1] || '').split(/\\bgroup\\b/i)[0];",
									"const having = query.split(/\\bhaving\\b/i)[1] || '';",
									"pm.test('WHERE inlines booking_platform, not alias bk_pf', function () {",
									"  pm.expect(where).to.match(/booking_platform/i);",
									"  pm.expect(where).to.not.match(/\"bk_pf\"/);",
									"  pm.expect(where).to.match(/Makemytrip/i);",
									"});",
									"pm.test('WHERE uses concat database function', function () {",
									"  pm.expect(where).to.match(/concat|\\|\\|/i);",
									"  pm.expect(where).to.match(/AgraMumbai/i);",
									"});",
									"pm.test('HAVING wraps formula with sum, not alias s_id', function () {",
									"  pm.expect(having).to.match(/sum\\s*\\(/i);",
									"  pm.expect(having).to.match(/source_id/i);",
									"  pm.expect(having).to.not.match(/sum\\s*\\(\\s*\"s_id\"/i);",
									"  pm.expect(having).to.match(/501501|10/);",
									"});"
								]
							}
						}
