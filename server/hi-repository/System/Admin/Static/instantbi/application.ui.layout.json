        {
          "key": "api_cache_fields",
          "title": "api_cache",
          "level": 1,
          "fields": [
            {
              "name": "api_cache_enabled",
              "label": "API cache enabled",
              "type": "boolean",
              "control": "tick",
              "span": 6
