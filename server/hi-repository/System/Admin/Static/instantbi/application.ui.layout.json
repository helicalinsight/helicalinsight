        {
          "key": "feature_flags_fields",
          "title": "toggles",
          "level": 1,
          "fields": [
            {
              "name": "enable_llm_usage_audit",
              "label": "Enable LLM usage audit",
              "type": "boolean",
              "control": "tick",
              "span": 6
            },
            {
              "name": "hide_prompt_reason",
              "label": "Hide prompt reason",
              "type": "boolean",
              "control": "tick",
              "span": 6
            },
            {
              "name": "enable_cache",
              "label": "Enable cache",
              "type": "boolean",
              "control": "tick",
              "span": 6
            },
            {
              "name": "enable_streaming",
              "label": "Enable streaming",
              "type": "boolean",
              "control": "tick",
              "span": 6
            },
            {
              "name": "enable_memory",
              "label": "Enable memory",
              "type": "boolean",
              "control": "tick",
              "span": 6
            }
          ]
        }
      ]
    },
    {
      "key": "sql_cache",
      "title": "sql / api_cache",
      "level": 0,
      "description": "Default row limit for generated SQL queries, and in-memory cache size for HI service API responses.",
