{
  "id": "instantbi-application",
  "title": "Application",
  "description": "InstantBI KPI suggestions, feature flags, SQL limit, and API cache",
  "sections": [
    {
      "key": "kpi",
      "title": "kpi",
      "level": 0,
      "description": "Default prompt Instant BI uses when suggesting KPIs. If the selected model defines its own suggestion query, that takes priority.",
      "sections": [
        {
          "key": "kpi_fields",
          "title": "question",
          "level": 1,
          "fields": [
            {
              "name": "suggestion_query",
              "label": "Suggestion query",
              "type": "textarea",
              "span": 24,
              "minRows": 1,
              "maxRows": 10,
              "autoSize": true,
              "description": "Prompt used when Instant BI suggests KPIs. A model-specific suggestion query overrides this when present."
            }
          ]
        }
      ]
    },
    {
      "key": "feature_flags",
      "title": "feature_flags",
      "level": 0,
