{
  "id": "temp-directory-clean",
  "title": "Temp Directory Clean",
  "description": "Remove old files from the temp directory on a schedule",
  "width": 860,
  "sections": [
    {
      "key": "identity",
      "title": "Identity",
      "description": "Unique id and runtime status flags",
      "fields": [
        {
          "name": "id",
          "label": "Schedule Id",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "span": 24
        },
        {
          "name": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "span": 12
        },
        {
          "name": "paused",
          "label": "Paused",
          "type": "boolean",
          "span": 12
        }
      ]
    },
    {
      "key": "schedule",
      "title": "Schedule",
      "description": "When the cleanup job runs and when it expires",
      "fields": [
        {
          "name": "expireDate",
          "label": "Expire Date",
          "type": "text",
          "span": 12,
          "placeholder": "never or yyyy-MM-dd'T'HH:mm:ss"
        },
        {
          "name": "scheduledTime",
          "label": "Scheduled Time",
          "type": "text",
          "span": 12,
          "placeholder": "HH:mm:ss"
        },
        {
          "name": "cron",
          "label": "Cron Expression",
          "type": "text",
          "span": 16,
          "placeholder": "Optional; overrides scheduledTime when set"
        },
        {
          "name": "timeZone",
          "label": "Time Zone",
          "type": "text",
          "span": 8,
          "placeholder": "e.g. Asia/Kolkata"
        }
      ]
    },
    {
      "key": "task",
      "title": "Task",
      "description": "Groovy script executed by the scheduler",
      "fields": [
        {
          "name": "task.script",
          "label": "Groovy Script",
          "type": "text",
          "span": 16,
          "readOnly": true
        },
        {
          "name": "task.function",
          "label": "Function",
          "type": "text",
          "span": 8
        }
      ]
    },
    {
      "key": "jobConfig",
      "title": "Cleanup Settings",
      "description": "How old files must be before they are deleted",
      "fields": [
        {
          "name": "noOfDays",
          "label": "Delete Files Older Than (Days)",
          "type": "number",
          "span": 12,
          "placeholder": "1"
        }
      ]
    },
    {
      "key": "email",
      "title": "Email Notification",
      "description": "Optional result email; blank To uses systemadmin",
      "fields": [
        {
          "name": "email.enabled",
          "label": "Send Email",
          "type": "boolean",
          "span": 8
        },
        {
          "name": "email.to",
          "label": "To",
          "type": "text",
          "span": 16,
          "placeholder": "blank = systemadmin"
        }
      ]
    }
  ]
}
